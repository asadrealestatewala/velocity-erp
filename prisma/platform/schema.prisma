// Velocity ERP — PLATFORM (control-plane) schema.
// One platform database lists every company (tenant) and runs billing, platform staff and the audit trail.
// Each company's own CRM data lives in its own PostgreSQL schema, described by ../schema.prisma.

generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@yadea/platform-client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
  RAAST
  EASYPAISA
  JAZZCASH
  SADAPAY
  NAYAPAY
  MANUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  FAILED
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
}

enum PlatformRole {
  OWNER
  BILLING
  SUPPORT
  ANALYTICS
}

/// A company (workspace). `dbSchema` + optional encrypted `dbUrlEnc` say where its CRM data lives.
model Tenant {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  status               TenantStatus       @default(PROVISIONING)
  isLegacy             Boolean            @default(false)
  dbSchema             String             @default("public")
  /// AES-GCM encrypted full connection string; null = same server as DATABASE_URL with `dbSchema`.
  dbUrlEnc             String?
  ownerName            String?
  ownerEmail           String?
  ownerEmailHash       String?
  timezone             String             @default("Asia/Karachi")
  currency             String             @default("PKR")
  countryCode          String             @default("92")
  emailConfirmedAt     DateTime?
  confirmTokenHash     String?
  confirmExpiresAt     DateTime?
  notes                String?
  // subscription state
  subStatus            SubscriptionStatus @default(PENDING)
  planKey              String?
  interval             BillingInterval    @default(MONTH)
  priceAmount          Int                @default(0)
  priceCurrency        String             @default("PKR")
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  graceUntil           DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  couponCode           String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  provisionedAt        DateTime?
  lastSeenAt           DateTime?
  schemaVersion        Int                @default(0)
  /// Offboarding: set when deletion is scheduled; the lifecycle job erases the workspace's data once the retention window has passed.
  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?
  deletionReason       String?
  /// Set once the workspace's data has been erased. The tenant row and its invoices are kept for accounting.
  dataPurgedAt         DateTime?
  /// Set when the owner unsubscribes from product/marketing emails (account and billing emails still go out).
  marketingOptOutAt    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  history       SubscriptionHistory[]
  invoices      Invoice[]
  payments      Payment[]
  addOns        TenantAddOn[]
  tickets       SupportTicket[]
  flagOverrides TenantFlagOverride[]
  activity      TenantActivity[]

  @@index([status])
  @@index([subStatus])
  @@index([deletionScheduledFor])
}

model Plan {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  isVisible      Boolean  @default(true)
  isRecommended  Boolean  @default(false)
  trialEligible  Boolean  @default(true)
  sortOrder      Int      @default(0)
  maxUsers       Int      @default(5)
  maxDealerships Int      @default(3)
  maxContacts    Int      @default(2000)
  maxStorageMb   Int      @default(1024)
  apiAccess      Boolean  @default(false)
  procurement    Boolean  @default(false)
  assistant      Boolean  @default(true)
  graceDays      Int      @default(7)
  features       Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prices PlanPrice[]
}

/// Prices are versioned: a change creates a new row and deactivates the old one; invoices keep what was charged.
model PlanPrice {
  id        String          @id @default(cuid())
  planId    String
  currency  String
  interval  BillingInterval
  /// Whole units of the currency (PKR rupees / USD dollars).
  amount    Int
  setupFee  Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  plan      Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, currency, interval, isActive])
}

model AddOn {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  extraUsers       Int      @default(0)
  extraDealerships Int      @default(0)
  extraContacts    Int      @default(0)
  extraStorageMb   Int      @default(0)
  giveApiAccess    Boolean  @default(false)
  priceMonthPkr    Int      @default(0)
  priceMonthUsd    Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  tenants TenantAddOn[]
}

model TenantAddOn {
  tenantId  String
  addOnId   String
  quantity  Int      @default(1)
  grantedBy String?
  reason    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addOn     AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([tenantId, addOnId])
}

model Coupon {
  id               String           @id @default(cuid())
  code             String           @unique
  percentOff       Int?
  amountOff        Int?
  currency         String?
  planKey          String?
  interval         BillingInterval?
  maxUses          Int?
  uses             Int              @default(0)
  validFrom        DateTime?
  validTo          DateTime?
  firstPaymentOnly Boolean          @default(true)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
}

model SubscriptionHistory {
  id         String              @id @default(cuid())
  tenantId   String
  at         DateTime            @default(now())
  fromStatus SubscriptionStatus?
  toStatus   SubscriptionStatus
  planKey    String?
  source     String
  actor      String?
  reason     String?
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
}

model Invoice {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  tenantId    String
  planKey     String
  interval    BillingInterval
  amount      Int
  setupFee    Int             @default(0)
  currency    String
  status      InvoiceStatus   @default(PAID)
  method      PaymentMethod
  reference   String?
  couponCode  String?
  periodStart DateTime
  periodEnd   DateTime
  issuedAt    DateTime        @default(now())
  paidAt      DateTime?
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refunds     Refund[]

  @@index([tenantId, issuedAt])
}

/// Every refund is also a numbered credit note (CN-00001) that can be downloaded as a PDF.
model Refund {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  invoiceId String
  amount    Int
  currency  String
  reason    String
  method    String?
  reference String?
  actor     String?
  at        DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// A payment a customer says they made (bank/wallet) or a provider reported. References are single-use per method.
model Payment {
  id           String          @id @default(cuid())
  tenantId     String
  method       PaymentMethod
  reference    String
  amount       Int
  currency     String
  planKey      String
  interval     BillingInterval
  couponCode   String?
  addOnKeys    Json            @default("[]")
  status       PaymentStatus   @default(PENDING)
  note         String?
  submittedAt  DateTime        @default(now())
  decidedAt    DateTime?
  decidedBy    String?
  rejectReason String?
  invoiceId    String?
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([method, reference])
  @@index([status, submittedAt])
  @@index([tenantId])
}

model BillingEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// Local payment accounts shown to customers (Raast, Easypaisa, JazzCash, bank).
model PaymentAccount {
  id           String        @id @default(cuid())
  method       PaymentMethod
  title        String
  accountName  String?
  accountNo    String
  bankName     String?
  instructions String?
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
}

model PlatformAdmin {
  id            String                  @id @default(cuid())
  email         String                  @unique
  name          String
  passwordHash  String
  role          PlatformRole            @default(SUPPORT)
  isActive      Boolean                 @default(true)
  totpSecretEnc String?
  totpEnabled   Boolean                 @default(false)
  recoveryCodes Json                    @default("[]")
  lastTotpStep  Int                     @default(0)
  tokenVersion  Int                     @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime                @default(now())
  sessions      PlatformSession[]
  resets        PlatformPasswordReset[]
}

/// Single-use password-reset links for platform operators (only the SHA-256 of the token is stored).
model PlatformPasswordReset {
  id        String        @id @default(cuid())
  adminId   String
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model PlatformSession {
  id         String        @id
  adminId    String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime      @default(now())
  /// Updated at most every few minutes while the session is in use.
  lastSeenAt DateTime?
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

/// A time-boxed, read-only "view as" session of a platform operator inside a tenant workspace. `id` is the SHA-256 of the cookie token.
/// Kept as history (no foreign keys) so records outlive deleted staff or workspaces.
model PlatformImpersonation {
  id         String    @id
  adminId    String
  adminEmail String
  tenantId   String
  tenantSlug String
  userId     String
  userName   String
  userEmail  String
  reason     String
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  endedAt    DateTime?

  @@index([adminId])
  @@index([tenantId, startedAt])
}

/// One row per workspace per day on which someone used it: the basis for retention and "came back" in the growth funnel.
model TenantActivity {
  tenantId String
  day      DateTime @db.Date
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day])
  @@index([day])
}

/// An email to workspace owners in a segment. `body` is paragraphs separated by blank lines.
model Campaign {
  id         String    @id @default(cuid())
  name       String
  subject    String
  body       String    @db.Text
  segment    String
  createdBy  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?
  recipients Int       @default(0)
  delivered  Int       @default(0)
  failed     Int       @default(0)
}

/// Append-only.
model PlatformAudit {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  adminId    String?
  adminEmail String?
  action     String
  targetType String?
  targetId   String?
  reason     String?
  detail     Json     @default("{}")
  ipAddress  String?
  userAgent  String?

  @@index([at])
  @@index([targetType, targetId])
}

model TrialClaim {
  ownerEmailHash String   @id
  tenantId       String
  claimedAt      DateTime @default(now())
}

model LifecycleNotice {
  id       String   @id @default(cuid())
  tenantId String
  key      String
  sentAt   DateTime @default(now())

  @@unique([tenantId, key])
}

model DemoRequest {
  id        String    @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String?
  createdAt DateTime  @default(now())
  handledAt DateTime?
  handledBy String?
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model PageView {
  id    String   @id @default(cuid())
  day   DateTime @db.Date
  path  String
  count Int      @default(1)

  @@unique([day, path])
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}

enum MailDirection {
  INBOUND
  OUTBOUND
}

/// Where an outgoing message got to (updated from the provider's delivery webhooks). NOT_SENT = no mail provider configured or the provider refused it.
enum MailDelivery {
  QUEUED
  SENT
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
  FAILED
  NOT_SENT
}

/// Workflow state of a received message in the console inbox.
enum MailInboxStatus {
  NEW
  OPEN
  RESOLVED
  SPAM
}

/// A sender identity: billing@, support@, no-reply@ … `receives` = mail sent to this address lands in the console inbox.
model MailMailbox {
  key         String   @id
  address     String   @unique
  displayName String
  replyTo     String?
  signature   String   @default("")
  receives    Boolean  @default(false)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

/// Operator edits of a built-in email template (key = e.g. "welcome"). Missing row = the built-in text.
model MailTemplate {
  key       String   @id
  subject   String
  heading   String
  body      String   @db.Text
  ctaLabel  String   @default("")
  ctaUrl    String   @default("")
  isEnabled Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Every email the platform sent or received (the console's inbox and sent log).
model MailMessage {
  id              String           @id @default(cuid())
  direction       MailDirection
  mailboxKey      String
  category        String?
  templateKey     String?
  fromAddress     String
  fromName        String?
  toAddress       String
  subject         String
  bodyText        String           @default("") @db.Text
  bodyHtml        String?          @db.Text
  providerId      String?
  messageIdHeader String?
  inReplyTo       String?
  threadKey       String
  tenantId        String?
  delivery        MailDelivery?
  deliveryDetail  String?
  inboxStatus     MailInboxStatus?
  readAt          DateTime?
  sentByEmail     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([direction, providerId])
  @@index([direction, mailboxKey, createdAt])
  @@index([threadKey])
  @@index([tenantId])
}

/// One execution of a scheduled job (lifecycle, per-workspace jobs). Pruned after 90 days.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    Json      @default("{}")
  error      String?

  @@index([job, startedAt])
}

/// Server-side failures worth an operator's attention (webhook handlers, jobs, unhandled request errors). Pruned after 30 days.
model ErrorLog {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  source  String
  message String
  stack   String?
  path    String?
  detail  Json     @default("{}")

  @@index([at])
  @@index([source, at])
}

/// One backup of the platform and its workspaces. `kind` is SCRIPT (npm run platform:backup) or MANUAL (an operator recorded a provider/off-site backup).
model BackupRun {
  id         String    @id @default(cuid())
  kind       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  location   String?
  note       String?
  /// SCRIPT runs: [{ schema, label, ok, bytes, verified, error? }]
  items      Json      @default("[]")
  recordedBy String?

  @@index([startedAt])
}

/// A notice shown in the app of every workspace (or one plan, or one workspace) between `startsAt` and `endsAt`. tone: info | warn | danger.
model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  tone      String    @default("info")
  planKey   String?
  tenantId  String?
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([isActive, startsAt])
}

enum TicketStatus {
  OPEN
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSource {
  CONSOLE
  MAIL
  APP
}

enum TicketMessageKind {
  CUSTOMER
  STAFF
  NOTE
}

/// A customer problem tracked to resolution, with an owner and a first-response deadline.
model SupportTicket {
  id                 String          @id @default(cuid())
  number             Int             @unique @default(autoincrement())
  tenantId           String?
  subject            String
  status             TicketStatus    @default(OPEN)
  priority           TicketPriority  @default(NORMAL)
  source             TicketSource    @default(CONSOLE)
  requesterName      String?
  requesterEmail     String?
  assigneeId         String?
  assigneeName       String?
  /// The inbox thread this ticket was created from (MailMessage.threadKey).
  mailThreadKey      String?
  firstResponseDueAt DateTime
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tenant             Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messages           TicketMessage[]

  @@index([status, priority])
  @@index([tenantId, createdAt])
  @@index([mailThreadKey])
}

model TicketMessage {
  id          String            @id @default(cuid())
  ticketId    String
  at          DateTime          @default(now())
  kind        TicketMessageKind
  authorName  String
  authorEmail String?
  body        String            @db.Text
  ticket      SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at])
}

/// A switch for a beta or optional feature. A workspace's setting is decided in this order: its own override, the plans listed in `planKeys`,
/// the percentage rollout (stable per workspace), then `enabled` (on for everyone).
model FeatureFlag {
  key            String               @id
  name           String
  description    String               @default("")
  enabled        Boolean              @default(false)
  planKeys       Json                 @default("[]")
  rolloutPercent Int                  @default(0)
  isArchived     Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  overrides      TenantFlagOverride[]
}

/// An exception for one workspace: forced on (beta access, a promise to a customer) or forced off.
model TenantFlagOverride {
  id       String      @id @default(cuid())
  tenantId String
  flagKey  String
  enabled  Boolean
  reason   String
  setBy    String?
  at       DateTime    @default(now())
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flag     FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, flagKey])
  @@index([flagKey])
}

/// A public notice on /status: something customers should know is broken or degraded. Written by staff; resolved when fixed.
model StatusIncident {
  id         String    @id @default(cuid())
  title      String
  body       String
  /// minor | major
  impact     String    @default("minor")
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  createdBy  String?

  @@index([startedAt])
}
