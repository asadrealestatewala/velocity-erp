{
  "name": "yadea-crm",
  "version": "1.0.0",
  "private": true,
  "description": "YADEA CRM & Dealership Management Platform",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "dev:webpack": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:seed:operations": "tsx --conditions=react-server scripts/seed-operations.ts",
    "db:sync": "tsx --conditions=react-server scripts/sync-permissions.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "jobs:run": "tsx --conditions=react-server scripts/run-jobs.ts",
    "assistant:check": "tsx scripts/check-assistant.ts",
    "forms:refresh-templates": "tsx --conditions=react-server scripts/refresh-form-templates.ts"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "nodemailer": "7.0.13",
    "pdfkit": "0.20.2",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.66.0",
    "recharts": "2.15.4",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.0",
    "@types/nodemailer": "7.0.3",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
