# ─────────────────────────────────────────────────────────────
# YADEA CRM — environment variables
# Copy to .env and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/yadea_crm?schema=public"

# Public base URL of the app — used for links in emails and CSRF origin checks (required in production)
APP_URL="http://localhost:3000"

# Secret used to hash IPs for rate limiting / spam protection and to sign form tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# IANA timezone for business dates (test-drive slots, opening hours, "today" in dashboards)
APP_TIMEZONE="Asia/Karachi"
# Same zone, exposed to the browser so dates render identically on server and client
NEXT_PUBLIC_APP_TIMEZONE="Asia/Karachi"

# The seeded demo accounts + password are listed on the sign-in pages ONLY when APP_URL points at
# localhost / 127.0.0.1 (so a real deployment never shows them). Set to "false" to hide them locally too.
SHOW_DEMO_CREDENTIALS="true"

# Session lifetime in days (default 7)
SESSION_TTL_DAYS=7

# Secret for the scheduled jobs endpoint (POST /api/jobs/run with header x-cron-secret)
CRON_SECRET="CHANGE_ME"

# ── File storage ─────────────────────────────────────────────
# "local" (default, stores in ./storage — development) or "s3" (any S3-compatible provider)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# Max upload size in megabytes (applies to all uploads)
MAX_UPLOAD_MB=10
# Required only when STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""            # optional, for S3-compatible providers (MinIO, R2, Wasabi...)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Email (optional) ─────────────────────────────────────────
# If SMTP_HOST is empty, emails are recorded in the outbox with status SKIPPED and
# only in-app notifications are delivered. Nothing is reported as "sent" unless SMTP accepts it.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="YADEA CRM <no-reply@example.com>"
# Optional Reply-To so customers' replies go to the mailbox / inbound-parse address that feeds /api/webhooks/email
EMAIL_REPLY_TO=""

# ── WhatsApp (Meta WhatsApp Business Cloud API) — optional ───
# Without these the Chat tab says "not connected" and conversations are logged manually. A message is only
# marked Sent after WhatsApp accepts it. Webhook URL to register in Meta: https://<your-domain>/api/webhooks/whatsapp
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Needed for inbound messages + delivery receipts: the app secret (signature check) and a verify token you choose
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# ── Inbound email — optional ─────────────────────────────────
# Shared secret for POST /api/webhooks/email (send it in the x-webhook-secret header from your inbound-parse service)
EMAIL_INBOUND_SECRET=""

# ── AI assistant — optional ──────────────────────────────────
# Without any of the settings below the assistant runs in built-in guide mode: it knows every screen and task and answers
# data questions with strict rules, but cannot answer open-ended questions or propose changes. To connect a real AI model
# choose ONE of the two options, paste your own key (never commit it), restart the app, then run `npm run assistant:check`.
#
# PRIVACY: whichever service you connect receives the question, the assistant's guide and the customer/dealer data the
# assistant looks up to answer it. Use a plan whose terms suit that data — free tiers of some services may use requests to
# improve their products.

# Option 1 — Claude (Anthropic). Defaults: claude-opus-5-5 and "medium" effort ("low" is faster and cheaper).
ANTHROPIC_API_KEY=""

# Option 2 — any service that speaks the OpenAI chat-completions protocol with tool/function calling:
# Google Gemini (free tier available), Groq, OpenRouter, OpenAI, or a local Ollama / LM Studio.
#   ASSISTANT_PROVIDER="openai-compatible"
#   ASSISTANT_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"   # Gemini; others: https://api.groq.com/openai/v1 · https://openrouter.ai/api/v1 · https://api.openai.com/v1 · http://localhost:11434/v1
#   ASSISTANT_MODEL="gemini-3.8-flash"     # any model that supports tool calling (the model list changes — check the service's docs)
#   ASSISTANT_API_KEY="..."                # not needed for a local server
ASSISTANT_PROVIDER=""
ASSISTANT_BASE_URL=""
ASSISTANT_API_KEY=""

# Shared: the model name (Claude default claude-opus-5-5; required for option 2) and Claude's effort.
ASSISTANT_MODEL=""
ASSISTANT_EFFORT=""
# Opt in to Anthropic's server-side refusal fallback (needs access to that beta on your account)
ASSISTANT_SERVER_FALLBACK="false"
